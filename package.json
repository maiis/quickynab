{
  "name": "quickynab",
  "version": "2.0.0",
  "description": "Quick and easy bank transaction imports to YNAB - supports 124+ banks worldwide",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "ynab": "dist/cli.js"
  },
  "scripts": {
    "dev": "concurrently \"bun run dev:vite\" \"bun run dev:server\"",
    "dev:vite": "vite",
    "dev:server": "bun --watch server.ts",
    "build": "bun run fetch:configs && bun run build:frontend && bun run build:backend && bun run copy:configs",
    "build:frontend": "vite build",
    "build:backend": "bun x tsc --project tsconfig.node.json",
    "fetch:configs": "bun scripts/fetch-bank-configs.ts",
    "copy:configs": "cp lib/parsers/bank2ynab-configs.json dist/lib/parsers/",
    "test": "bun test",
    "typecheck": "bun x tsc --project tsconfig.test.json",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write .",
    "prepublishOnly": "bun run check && bun run typecheck && bun test && bun run build",
    "start": "bun dist/cli.js",
    "web": "bun dist/server.js",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "keywords": [
    "ynab",
    "csv",
    "import",
    "cli",
    "bank",
    "transactions",
    "bank2ynab",
    "budgeting"
  ],
  "author": "maiis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maiis/quickynab.git"
  },
  "bugs": {
    "url": "https://github.com/maiis/quickynab/issues"
  },
  "homepage": "https://github.com/maiis/quickynab#readme",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "preferGlobal": true,
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "commander": "15.0.0",
    "csv-parse": "7.0.2",
    "ynab": "4.5.0"
  },
  "optionalDependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.1",
    "@types/node": "26.4.1",
    "concurrently": "10.0.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json}": "biome check --write --no-errors-on-unmatched"
  }
}
